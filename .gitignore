# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Node ----
node_modules/
dist/
build/
*.log
npm-debug.log*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---- Data / weights (large, gitignored per spec) ----
weights/
data/
checkpoints/
*.pt
*.pth
*.tiff
*.las
storage/
runs/

# E2E fixtures are small, purpose-built assets that CI needs: keep them tracked.
!e2e/fixtures/scan/*.tiff
!e2e/fixtures/scan/*.las

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
