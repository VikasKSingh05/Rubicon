{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assessment",
  "description": "Satellite assessment created from an xBD pre/post image pair. Historical aliases are optional and read-only compatibility fields.",
  "type": "object",
  "required": [
    "_id",
    "user",
    "state",
    "filename",
    "prediction",
    "confidence",
    "class_probs",
    "geojson_polygon",
    "model_version",
    "preCid",
    "postCid",
    "txHash",
    "chainVerified",
    "timestamps",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "_id": { "type": "string", "description": "ObjectId hex" },
    "user": { "type": "string", "description": "ObjectId of owning user" },
    "state": {
      "type": "string",
      "enum": ["uploaded", "analyzing", "analyzed", "chain_pending", "chain_logged", "error"]
    },
    "filename": {
      "type": "object",
      "properties": {
        "pre": { "type": ["string", "null"] },
        "post": { "type": ["string", "null"] },
        "hsi": { "type": ["string", "null"], "deprecated": true },
        "lidar": { "type": ["string", "null"], "deprecated": true }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "pre": { "type": ["string", "null"] },
        "post": { "type": ["string", "null"] },
        "hsi": { "type": ["string", "null"], "deprecated": true },
        "lidar": { "type": ["string", "null"], "deprecated": true }
      }
    },
    "prediction": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "class_probs": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "number" }
    },
    "geojson_polygon": {
      "type": ["object", "null"],
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": { "type": "array", "description": "array of [longitude, latitude] rings" }
      }
    },
    "model_version": { "type": ["string", "null"] },
    "buildings_geojson": { "type": ["object", "null"] },
    "preCid": { "type": ["string", "null"] },
    "postCid": { "type": ["string", "null"] },
    "hsiCid": { "type": ["string", "null"], "deprecated": true },
    "lidarCid": { "type": ["string", "null"], "deprecated": true },
    "txHash": { "type": ["string", "null"] },
    "chainVerified": { "type": "boolean" },
    "timestamps": {
      "type": "object",
      "properties": {
        "uploaded": { "type": ["string", "null"], "format": "date-time" },
        "analyzing": { "type": ["string", "null"], "format": "date-time" },
        "analyzed": { "type": ["string", "null"], "format": "date-time" },
        "chainPending": { "type": ["string", "null"], "format": "date-time" },
        "chainLogged": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
