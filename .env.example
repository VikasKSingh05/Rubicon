# Rubicon — Environment Template
#
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Generate secrets locally; keep each teammate's values private.

# ===== MongoDB =====
MONGO_URI=                          # 🔴 your Atlas/self-hosted connection string

# ===== Pinata (IPFS) =====
PINATA_JWT=                         # 🔴 from app.pinata.cloud; CIDs are computed locally without it

# ===== Blockchain =====
AMOY_RPC_URL=https://rpc-amoy.polygon.technology   # 🟡 replace with Alchemy/Infura for reliability
DEPLOYER_PRIVATE_KEY=               # 🔴 fresh testnet-only wallet key, never a personal key
CONTRACT_ADDRESS=                   # 🔴 filled in after deploy.js runs
CHAIN_ID=80002
RUBICON_CONTRACT_OUT=               # 🟡 optional path for deploy.js to write the printed address

# ===== Agentic AI (provider chosen by LLM_PROVIDER) =====
# Read by agent-service. Pick ONE provider and set its key. Without keys the
# agent uses a deterministic tool-grounded fallback that answers strictly from
# the backend API.
#   - "anthropic": direct Anthropic API (AGENT_MODEL, ANTHROPIC_API_KEY)
#   - "openai":    direct OpenAI API (OPENAI_MODEL, OPENAI_API_KEY)
#   - "openrouter": OpenAI-compatible router (OPENROUTER_MODEL, OPENROUTER_API_KEY)
LLM_PROVIDER=openrouter             # 'anthropic' | 'openai' | 'openrouter' | '' (fallback agent)
ANTHROPIC_API_KEY=                  # 🔴 if using Anthropic directly
AGENT_MODEL=claude-sonnet-4-5       # 🔴 confirm current recommended model string at build time
OPENAI_API_KEY=                     # 🔴 if using OpenAI directly
OPENAI_MODEL=gpt-4o                 # 🟡 confirm current recommended model string at build time
OPENROUTER_API_KEY=                 # 🔴 if using OpenRouter
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet   # any OpenRouter model slug

# ===== Auth =====
JWT_SECRET=                         # 🔴 generate with `openssl rand -hex 32`; required in production
ACCESS_TOKEN_TTL=15m                # short-lived access token window (e.g. 15m)

# ===== Application =====
NODE_ENV=development                 # 'production' enforces secret checks on boot
MAX_UPLOAD_MB=100
STORAGE_DIR=storage                  # originals persisted to this directory
CORS_ORIGINS=http://localhost:3000   # comma-separated allowlist
RATE_LIMIT_DISABLED=0                # set to 1 to disable auth/upload rate limits (dev only)

# ===== Service URLs =====
AI_ENGINE_URL=http://ai-engine:8000  # backend -> ai-engine (compose internal DNS)
BACKEND_URL=http://backend:4000      # agent-service -> backend (compose internal DNS)

# ===== AI engine =====
RUBICON_MODEL_DIR=./data/models      # directory containing the trained serving artifact
AI_ENGINE_MAX_MB=100                 # max upload size accepted by the engine

# ===== Ports (host mapping) =====
BACKEND_PORT=4000
FRONTEND_PORT=3000
AI_ENGINE_PORT=8000
AGENT_SERVICE_PORT=8001

# ===== Frontend (build-time Vite vars; browser-side defaults) =====
# When unset the frontend build bakes `http://localhost:4000` / `:8001` into dist.
# Set these to the public URLs (including scheme) when serving from another host.
VITE_API_URL=http://localhost:4000
VITE_AGENT_URL=http://localhost:8001