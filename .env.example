# Rubicon — Environment Template
#
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Generate secrets locally; keep each teammate's values private.

# ===== MongoDB =====
MONGO_URI=                          # 🔴 your Atlas connection string
MONGO_DB=rubicon

# ===== Pinata (IPFS) =====
PINATA_JWT=                         # 🔴 from app.pinata.cloud; CIDs are computed locally without it

# ===== Blockchain =====
AMOY_RPC_URL=https://rpc-amoy.polygon.technology   # 🟡 replace with Alchemy/Infura for reliability
DEPLOYER_PRIVATE_KEY=               # 🔴 fresh testnet-only wallet key, never a personal key
CONTRACT_ADDRESS=                   # 🔴 filled in after deploy.js runs
CHAIN_ID=80002

# ===== Agentic AI (configurable: see Phase 0 decision) =====
# Read by agent-service for Phase 4 tool-calling. Pick ONE provider and set its
# key; LLM_PROVIDER selects which. Without keys the agent uses a deterministic
# tool-grounded fallback that answers strictly from the backend API.
#   - "anthropic": direct Anthropic API (AGENT_MODEL, ANTHROPIC_API_KEY)
#   - "openai":    direct OpenAI API (OPENAI_MODEL, OPENAI_API_KEY)
#   - "openrouter": OpenAI-compatible router (OPENROUTER_MODEL, OPENROUTER_API_KEY)
#     any OpenRouter slug works, e.g. anthropic/claude-3.5-sonnet, openai/gpt-4o
LLM_PROVIDER=openrouter             # 'anthropic' | 'openai' | 'openrouter' | '' (fallback agent)
ANTHROPIC_API_KEY=                  # 🔴 if using Anthropic directly
AGENT_MODEL=claude-sonnet-4-6       # 🔴 confirm current recommended model string at build time
OPENAI_API_KEY=                     # 🔴 if using OpenAI directly
OPENAI_MODEL=gpt-4o                 # 🟡 confirm current recommended model string at build time
OPENROUTER_API_KEY=                 # 🔴 if using OpenRouter
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet   # any OpenRouter model slug

# ===== Auth =====
JWT_SECRET=                         # 🔴 generate with `openssl rand -hex 32`

# ===== Service URLs (docker-compose internal networking) =====
AI_ENGINE_URL=http://ai-engine:8000
AGENT_SERVICE_URL=http://agent-service:8001

# ===== Ports (host mapping) =====
BACKEND_PORT=4000
FRONTEND_PORT=3000
AI_ENGINE_PORT=8000
AGENT_SERVICE_PORT=8001

# ===== Frontend (build-time Vite vars; browser-side defaults) =====
# VITE_API_URL=http://localhost:4000
# VITE_AGENT_URL=http://localhost:8001
