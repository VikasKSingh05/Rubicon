# Rubicon — Environment Template
#
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Generate secrets locally; keep each teammate's values private.

# ===== MongoDB =====
MONGO_URI=                          # 🔴 your Atlas connection string
MONGO_DB=rubicon

# ===== Pinata (IPFS) =====
PINATA_JWT=                         # 🔴 from app.pinata.cloud
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ===== Blockchain =====
AMOY_RPC_URL=https://rpc-amoy.polygon.technology   # 🟡 replace with Alchemy/Infura for reliability
DEPLOYER_PRIVATE_KEY=               # 🔴 fresh testnet-only wallet key, never a personal key
CONTRACT_ADDRESS=                   # 🔴 filled in after deploy.js runs
CHAIN_ID=80002

# ===== Agentic AI (configurable: see Phase 0 decision) =====
# Use either provider. At least one key must be set; LLM_PROVIDER selects which.
LLM_PROVIDER=anthropic              # 'anthropic' | 'openai'
ANTHROPIC_API_KEY=                  # 🔴 if using Anthropic
AGENT_MODEL=claude-sonnet-4-6       # 🔴 confirm current recommended model string at build time
OPENAI_API_KEY=                     # 🔴 if using OpenAI
OPENAI_MODEL=gpt-4o                 # 🟡 confirm current recommended model string at build time

# ===== Auth =====
JWT_SECRET=                         # 🔴 generate with `openssl rand -hex 32`

# ===== Service URLs (docker-compose internal networking) =====
AI_ENGINE_URL=http://ai-engine:8000
AGENT_SERVICE_URL=http://agent-service:8001

# ===== Ports (host mapping) =====
BACKEND_PORT=4000
FRONTEND_PORT=3000
AI_ENGINE_PORT=8000
AGENT_SERVICE_PORT=8001
